########################################
# CLICK LOCATION COORDINATES
########################################

SELECT_BTN = (284, 62)
JOB_NR_FIELD = (310, 221)
UPDATE_BTN = (384, 65)
OPEN_WITH_USER_IN_BOOKING_NO_BTN = (332, 279)
WARNING_OK = (418, 147)
COSTS_TAB = (835, 148)
INSERT_BTN = (384, 65)
SAVE_BTN = (235, 63)
CLOSE_BTN = (35, 64)
REQ_VALUE_MISSING_OK = (378, 142)
FIRST_LINE_FIRST_FIELD = (282, 325)
CLOSE_WITHOUT_SAVING_YES = (216,162)
DELETE_BTN = (485, 64)
DELETE_YES = (101, 146)
STATE_PIXEL = (1500,580)
BOOKING_START_DRAG = (900,476)
BOOKING_END_DRAG = (900,991)
COSTS_AREA = ((9,314), (616,960))

########################################
# CONSTANTS
########################################

WAIT_TILL_JOB_OPEN = 6
WAIT_TILL_SAVE = 10
WHITE = (255,255,255)
BLUE = (150,200,255)
DARK_BLUE = (0,120,215)

########################################

Prompt user for input csv file
Verify that the CSV file contains the following columns: Job, Type, Currency, Cost, Per

FAILED_COSTS = input file base name with failed appended and csv extension
SUCCEEDED_COSTS = input file base name with succeeded appended and csv extension

To both FAILED_COSTS and SUCCEEDED_COSTS files add input file column names

########################################
# MAIN LOOP
########################################

Iterate row by row through input file assigning the values of Job, Type, Currency and Cost to variables with the same name

########################################
# OPEN JOB
########################################

Target window "Softship LINE"

# Color of STATE_PIXEL is either WHITE (query mode) or BLUE (result mode)]

# If in result mode
IF STATE_PIXEL color equals BLUE
    # Open query mode
    Click SELECT_BUTTON

# Wait for pixel color change to query mode before continuing
WHILE STATE_PIXEL color not equal to QUERY_MODE
    Do nothing

# Job number input field (Job number field)
Target window "Softship LINE"
Click JOB_NR_FIELD

# Enter job number
Enter current value from variable

# Execute query
Click SELECT_BUTTON

# Wait for pixel color change to result mode before continuing
WHILE STATE_PIXEL color not equal to BLUE
    Do nothing

# Enter booking
Click UPDATE_BTN

IF "Question" window popup occurs
        Save current row of input csv file row to failed jobs output file
        Target window "Question"
        Click OPEN_WITH_USER_IN_BOOKING_NO_BTN

        Continue Main loop

# Wait for pixel color change to WHITE (booking opening in progress)
WHILE STATE_PIXEL color not equal to WHITE
    Do nothing

# Wait for and clear Warning window
WHILE STATE_PIXEL color not equal to BLUE or "Warning" window does not occur or timeout of 5s not reached
    Do nothing

IF window warning exists
    # Clear warning
    Target window "Warning"
    Click WARNING_OK

# Wait for STATE_PIXEL to change BLUE (booking has finished loading)
WHILE STATE_PIXEL not BLUE:
    Do nothing

########################################
# ENTER COST TAB
########################################

Target window "Softship LINE"
Click COSTS_TAB

# Wait for the drag bar of the costs tab to appear
WHILE BOOKING_START_DRAG not changed
    Do nothing

# Expand cost view

Click and drag mouse from BOOKING_START_DRAG to BOOKING_END_DRAG

########################################
# Scan prexisting costs
########################################

Tak screenshot of COSTS_AREA and parse with tesseract
Extract lines and filter by TYPE of cost for entry
If matching TYPE is found sum prexisting costs taking into account sign

# Calculate difference between target cost and prexisting sum value
Subtract prexisting costs of the same type from the target value

# Skip cost addition if difference equals zero
IF DIFFERENCE equals zero
    # Click "Close" button
    Click CLOSE_BTN

    # Handle any popup windows (non should occur)

    # Wait for booking to close
    WHILE BOOKING_END_DRAG not BLUE
        Do nothing

    Continue main loop

########################################
# ENTER COST
########################################

# Add new cost line (Insert button)
Click INSERT_BTN

# First field of added line is auto selected
Input TYPE from variable
Tab to next field
Input '1'
Tab to next field
Input '+' or '-' depending on sign of calculated difference
Tab to next field
Input Currency
Tab to next field
Input integer component of Cost from variable symbol by symbol
Send ',' (comma)
Input decimal component from variable symbol by symbol
Tab to next field
Input Per value from calculated difference variable

# Validation
Take secondary screenshot of COSTS_AREA

########################################
SAVE CHANGES
########################################

# Click "Save" button
Click SAVE_BTN

# Wait for booking to close
WHILE BOOKING_END_DRAG not BLUE
    Do nothing

IF "Warning" window popup occurs
        # Clear warning popup window 
        Target window "Warning"
        Click WARNING_OK

        # Click "Close" button
        Click CLOSE_BTN

        Continue Main loop

####################
# IF "Required Value Missing" window occurs
####################

# Clear "Required Value Missing" window
Target window "Required Value Missing"
Click REQ_VALUE_MISSING_OK

# Click on first line first field
Click FIRST_LINE_FIRST_FIELD
# Contents is autoselected
Copy contents to variable

####################
IF contents not empty
####################

        ########################################
        COST ENTRY FAILURE
        ########################################

        # If contents is not empty
        # Save current row input csv file row to failed jobs output file
        # Click "Close" button
        Click CLOSE_BTN

        # Clear "Required Value Missing" window
        Target window "Required Value Missing"
        Click REQ_VALUE_MISSING_OK

        # Clear "Question" window popup
        Target window "Question"
        Click CLOSE_WITHOUT_SAVING_YES

########################################
CLEAR CLOSING WARNINGS AND ERRORS
########################################

# If contents is empty
# Delete empty line
Click DELETE_BTN

# Clear "Question" window popup
Target window "Question"
Click DELETE_YES

# Click "Close" button
Click CLOSE_BTN
